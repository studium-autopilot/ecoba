#!/usr/bin/env bash
# studium-server: Befehle für den eigenen Server von Studium Autopilot (server/README.md). Liegt nach der Installation
# unter /usr/local/bin/studium-server.
set -euo pipefail

PAKET=/opt/studium-server/aktuell
KONFIG=/etc/studium-server/dienst.json
DATEN=/var/lib/studium-server
ZUGANG=/etc/credstore.encrypted/uni-zugang
CLAUDE=/var/lib/studium/.local/bin/claude
RELEASES=https://api.github.com/repos/studium-autopilot/ecoba/releases/latest

hilfe() {
  cat <<'TEXT'
studium-server status                  Stand des Servers (wie /v1/status) und der Dienste
studium-server verbinden               Einmal-Link und QR-Code, um ein Gerät mit Obsidian zu verbinden (30 Minuten gültig)
studium-server schluessel-erneuern     neue Schlüssel (Gerät verloren): offene Codes weg, jedes Gerät muss sich neu verbinden
studium-server uni-zugang setzen       Uni-Benutzername und -Passwort verschlüsselt speichern (verdeckte Eingabe)
studium-server uni-zugang loeschen     gespeicherten Uni-Zugang löschen
studium-server uni-zugang pruefen      zeigt nur, ob ein Zugang gespeichert und entschlüsselbar ist
studium-server zustand                 Zustand für den Status jetzt neu prüfen
studium-server jetzt                   Claude-Lauf jetzt anstoßen (mit Gmail)
studium-server modell sonnet|opus      Modell für die Claude-Läufe (Standard: sonnet, schont das Limit)
studium-server lauf                    Ergebnis des letzten Claude-Laufs
studium-server nutzung                 Claude-Läufe und Token je Tag (letzte 7 Tage), Treffer am Limit des Abos
studium-server aktualisieren           Pakete (Caddy, Node.js, CouchDB) und Claude Code aktualisieren, neuestes Server-Paket aus dem Release holen (Prüfsumme, Signatur) und installieren
studium-server livesync                LiveSync einschalten (falls nötig), dann Link und Code für ein Gerät (30 Minuten)
studium-server livesync einschalten    nur einschalten: CouchDB für den Tresor, HTTPS unter obsidian.<IP>.sslip.io
studium-server livesync verbinden      nur Link und Code für ein weiteres Gerät
TEXT
}

root_noetig() {
  [ "$(id -u)" -eq 0 ] || { echo "Bitte mit sudo starten: sudo studium-server $*" >&2; exit 1; }
}

# umask 077 wie in den Einheiten (sudo nimmt die strengere aus dieser und seiner eigenen): Was als studium entsteht, liest nur
# studium, außer ein Teil setzt die Rechte selbst (zustand.json, aktualisierung.json)
als_studium() {
  (
    umask 077
    if [ "$(id -un)" = studium ]; then
      STUDIUM_SERVER_KONFIG="$KONFIG" STUDIUM_SERVER_DATEN="$DATEN" "$@"
    else
      sudo -u studium -H env STUDIUM_SERVER_KONFIG="$KONFIG" STUDIUM_SERVER_DATEN="$DATEN" "$@"
    fi
  )
}
# Was der Web-Dienst liest und schreibt (web/: Einmal-Codes, takt.json), nur als dessen Benutzer: root folgt so keinem Link, den er
# dort hinlegt, und was entsteht, gehört ihm (server/README.md, „Wer was liest und schreibt“)
als_web() {
  sudo -u studium-web env STUDIUM_SERVER_KONFIG="$KONFIG" STUDIUM_SERVER_DATEN="$DATEN" "$@"
}

port() { jq -r '.port // 8743' "$KONFIG" 2>/dev/null || echo 8743; }

# Gerät verloren: neuer Zugangs- und Datenschlüssel (32 Byte, base64url wie in installieren.sh), alle offenen Einmal-Codes weg.
# Der Web-Dienst steht dabei still, damit niemand mit den alten Schlüsseln einen Code holt oder einen offenen einlöst; der trap
# startet ihn auch nach einem Fehler wieder. dienst.json entsteht daneben (erst nur root, dann root:studium-web 0640) und ersetzt die
# alte in einem Schritt (mv). Adresse, Port und Version bleiben; installieren.sh behält die neuen Schlüssel bei jedem weiteren Lauf.
schluessel_erneuern() {
  root_noetig schluessel-erneuern
  local neu="$KONFIG.neu"
  systemctl stop studium-server-dienst.service
  trap 'systemctl start studium-server-dienst.service' EXIT
  als_web sh -c 'rm -f -- "$1"/web/verbinden/*' - "$DATEN"
  rm -f "$neu"
  STUDIUM_KONFIG="$KONFIG" STUDIUM_NEU="$neu" node --input-type=module -e '
    import { readFileSync, writeFileSync } from "node:fs";
    import { randomBytes } from "node:crypto";
    const k = JSON.parse(readFileSync(process.env.STUDIUM_KONFIG, "utf8"));
    if (!k || typeof k !== "object" || !k.zugang || !k.schluessel) throw new Error("dienst.json ohne Schlüssel");
    k.zugang = randomBytes(32).toString("base64url");
    k.schluessel = randomBytes(32).toString("base64url");
    writeFileSync(process.env.STUDIUM_NEU, JSON.stringify(k, null, 2) + "\n", { mode: 0o600, flag: "wx" });
  '
  chown root:studium-web "$neu"
  chmod 0640 "$neu"
  mv -f "$neu" "$KONFIG"
  echo "Neue Schlüssel gelten ab jetzt, die alten und alle offenen Codes nicht mehr."
  echo "Jedes Gerät muss sich neu verbinden: das erste mit sudo studium-server verbinden (in der Cloud Shell:"
  echo "bash ~/studium-autopilot/server/fern.sh verbinden), jedes weitere in Obsidian unter Eigener Server mit „Weiteres Gerät verbinden“."
}

uni_zugang() {
  case "${1:-}" in
    setzen)
      root_noetig uni-zugang setzen
      read -r -p "Uni-Benutzername: " benutzer
      [ -n "$benutzer" ] || { echo "Kein Benutzername eingegeben." >&2; exit 1; }
      eingabe=$(systemd-ask-password --emoji=no "Uni-Passwort (wird nicht angezeigt):")
      [ -n "$eingabe" ] || { echo "Kein Passwort eingegeben." >&2; exit 1; }
      install -d -m 0755 /etc/credstore.encrypted
      # printf ist eingebaut: Das Passwort steht nie in einer Befehlszeile (ps), nur in Pipes.
      printf '%s\n%s\n' "$benutzer" "$eingabe" \
        | python3 -c 'import json,sys; b=sys.stdin.readline().rstrip("\n"); p=sys.stdin.readline().rstrip("\n"); sys.stdout.write(json.dumps({"username": b, "password": p}))' \
        | systemd-creds encrypt --name=uni-zugang - "$ZUGANG"
      unset eingabe
      chmod 0600 "$ZUGANG"
      rm -f "$DATEN/abruf/uni-zugang-falsch"
      als_studium node "$PAKET/zustand.mjs" >/dev/null || true
      echo "Uni-Zugang verschlüsselt gespeichert."
      ;;
    loeschen)
      root_noetig uni-zugang loeschen
      rm -f "$ZUGANG" "$DATEN/abruf/uni-zugang-falsch"
      als_studium node "$PAKET/zustand.mjs" >/dev/null || true
      echo "Uni-Zugang gelöscht. Es laufen nur noch Quellen ohne Anmeldung."
      ;;
    pruefen)
      root_noetig uni-zugang pruefen
      if systemd-creds decrypt --name=uni-zugang "$ZUGANG" - >/dev/null 2>&1; then echo "gespeichert"; else echo "fehlt"; fi
      ;;
    *) hilfe; exit 1 ;;
  esac
}

# Ist Version $1 neuer als $2? Wie bei SemVer zählt eine Vorabversion weniger als die fertige mit derselben Nummer
# (0.5.9-beta.1 < 0.5.9 < 0.5.10); sort -V allein sähe 0.5.9-beta.1 nach 0.5.9. Gleiche Fassung in installieren.sh.
version_neuer() {
  local a=$1 b=$2 ka=${1%%-*} kb=${2%%-*}
  [ "$a" != "$b" ] || return 1
  if [ "$ka" = "$kb" ]; then
    [ "$a" != "$ka" ] || return 0
    [ "$b" != "$kb" ] || return 1
    ka=${a#*-} kb=${b#*-}
  fi
  [ "$(printf '%s\n%s\n' "$ka" "$kb" | sort -V | tail -n 1)" = "$ka" ]
}

# Claude Code aktuell halten: Eine alte Fassung kennt neuere Schalter oder Modellnamen nicht. Nie während eines Claude-Laufs,
# damit der laufende nicht mitten im Wechsel steckt; dann beim nächsten Mal. Der Lauf ist Type=oneshot: Während er läuft, ist
# er „activating“, nicht „active“ (systemctl is-active sähe ihn nicht). Ohne Nutzungs- und Fehlerberichte, wie im Lauf.
claude_aktualisieren() {
  [ -x "$CLAUDE" ] || return 0
  case "$(systemctl show -P ActiveState studium-server-lauf.service 2>/dev/null || true)" in
    activating|active|deactivating|reloading)
      echo "Claude Code: Ein Lauf läuft gerade; Update beim nächsten Mal."
      return 0 ;;
  esac
  sudo -u studium -H env DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 "$CLAUDE" update \
    || echo "Claude Code ließ sich nicht aktualisieren; nächster Versuch beim nächsten Mal." >&2
}

# Ergebnis von „aktualisieren“ für den Status (dienst.mjs liest aktualisierung.json für /v1/status, das Plugin sagt es unter
# Verbindungen): zeit, ok, ziel (neuestes Release, soweit bekannt), grund (nur bei einem Fehler: der Schritt, Wörter wie
# AKTUALISIERUNG_GRUENDE in dienst.mjs) und erfolg (zuletzt ohne Fehler; bleibt bei einem Fehler stehen, ohne frühere Angabe die
# Installation des laufenden Pakets). Schreibt als studium wie alles in $DATEN: root schreibt nie in einen Ordner, den ein
# anderer Benutzer ändern kann. 0640: Der Web-Dienst liest die Datei über die Gruppe studium-web, die der Datenordner vererbt.
AKT_ZIEL=""
AKT_GRUND=""
AKT_TMP=""
aktualisierung_merken() {
  local ok=false jetzt erfolg=""
  jetzt=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  [ "$1" -ne 0 ] || ok=true
  if [ "$ok" = true ]; then
    erfolg=$jetzt AKT_GRUND=""
  else
    erfolg=$(als_studium cat "$DATEN/aktualisierung.json" 2>/dev/null | sed -n 's/.*"erfolg":"\([0-9T:Z-]\{20\}\)".*/\1/p' || true)
    [ -n "$erfolg" ] || erfolg=$(date -u -r "$PAKET/VERSION" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
    AKT_GRUND=${AKT_GRUND:-unbekannt}
  fi
  [[ "$AKT_ZIEL" =~ ^[0-9A-Za-z.+-]{1,40}$ ]] || AKT_ZIEL=""
  printf '{"zeit":"%s","ok":%s,"ziel":"%s","grund":"%s","erfolg":"%s"}\n' "$jetzt" "$ok" "$AKT_ZIEL" "$AKT_GRUND" "$erfolg" \
    | als_studium sh -c 'umask 027 && cat >"$1.neu" && mv -f "$1.neu" "$1"' - "$DATEN/aktualisierung.json" \
    || echo "Das Ergebnis ließ sich nicht festhalten." >&2
}
# Am Ende von „aktualisieren“ (trap EXIT, auch nach exit und set -e): Download-Ordner weg, Ergebnis festhalten. Lief sonst alles,
# aber die Pakete nicht, gilt der Lauf als gescheitert (Grund pakete, Exit 1).
aktualisieren_ende() {
  local code=$1
  [ -z "$AKT_TMP" ] || rm -rf "$AKT_TMP"
  if [ "$code" -eq 0 ] && [ "$PAKETE_FEHLER" -ne 0 ]; then AKT_GRUND=pakete code=1; fi
  aktualisierung_merken "$code"
  [ "$code" -eq "$1" ] || exit "$code"
}

# Pakete der Teile, die aus dem Internet erreichbar sind oder den Server tragen: Caddy, Node.js, mit LiveSync CouchDB. Jeden Tag,
# nicht nur mit einer neuen Version des Server-Pakets (bis 0.7.6 kam dieser Schritt erst danach, also fast nie). unattended-upgrades
# holt Sicherheitsupdates ohnehin jede Nacht (installieren.sh, „Sicherheitsupdates“); das hier ist die zweite Sicherung. Ein Fehler
# (etwa ein Archiv nicht erreichbar) hält das Update des Server-Pakets nicht auf, zählt aber am Ende. Neustarts nach einem neuen
# Node.js: veraltete_neu_starten.
# Nur Pakete, die installiert sind: CouchDB (und sein Paketarchiv) kommt erst mit LiveSync (livesync.sh). Ohne das Archiv kennt apt
# das Paket nicht und bricht ab („Unable to locate package“); bis 0.7.6 blieben so auf jedem Server ohne LiveSync auch Caddy und
# Node.js stehen, und der Status meldete jeden Tag „pakete“. Installiert heißt Status „installed“ (dpkg -s gelänge auch, wenn nur
# noch die Konfiguration eines entfernten Pakets da ist).
PAKETE_FEHLER=0
pakete_aktualisieren() {
  local p pakete=()
  for p in caddy nodejs couchdb; do
    [ "$(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null || true)" != installed ] || pakete+=("$p")
  done
  [ ${#pakete[@]} -gt 0 ] || return 0
  if ! { apt-get -q -o DPkg::Lock::Timeout=600 update >/dev/null \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -q -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold \
      --only-upgrade "${pakete[@]}" >/dev/null; }; then
    echo "Pakete ließen sich nicht aktualisieren; nächster Versuch beim nächsten Mal." >&2
    PAKETE_FEHLER=1
  fi
}

# Dauerdienste mit Node.js (Web-Dienst, Speicherreserve) neu starten, wenn ihr laufendes Programm nicht mehr das installierte ist.
# Ein Update von Node.js ersetzt /usr/bin/node; ein laufender Prozess behält das alte, gelöschte Programm, und /proc/<PID>/exe zeigt
# dann „… (deleted)“. So auch nach einem Update, das unattended-upgrades in der Nacht eingespielt hat (bis 0.7.6 startete nur ein
# neues Node.js aus pakete_aktualisieren selbst die Dienste neu, eins aus der Nacht lief bis zum nächsten Neustart des Servers mit
# dem alten weiter). Ein Dienst, der nicht läuft (MainPID 0), bleibt, wie er ist. Die Lauf-Dienste starten ohnehin jedes Mal neu.
NODE_DIENSTE=(studium-server-dienst.service studium-server-speicher.service)
veraltete_neu_starten() {
  local d pid exe
  for d in "${NODE_DIENSTE[@]}"; do
    pid=$(systemctl show -P MainPID "$d" 2>/dev/null || true)
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || continue
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    [[ "$exe" == *" (deleted)" ]] || continue
    echo "$d läuft noch mit dem alten Node.js: Neustart"
    systemctl try-restart "$d" || echo "$d ließ sich nicht neu starten." >&2
  done
}

# Signatur: Die Prüfsumme nennt GitHub selbst; sie schützt vor einem kaputten Download, nicht vor einem fremden Paket. Wer das
# Konto oder ein Token des Repos hätte, könnte ein Release mit eigenem Paket anlegen, und jeder Server installierte es als root.
# Darum nur ein Paket mit gültiger Signatur (ssh-keygen -Y, Namensraum studium-server) eines Schlüssels aus allowed_signers des
# LAUFENDEN Pakets, nie aus dem Download. Signiert wird beim Bauen des Releases (docs/release.md, „Signatur des Server-Pakets“).
aktualisieren() {
  root_noetig aktualisieren
  claude_aktualisieren
  local info url signatur pruefsumme neu alt
  trap 'aktualisieren_ende $?' EXIT
  pakete_aktualisieren
  veraltete_neu_starten
  AKT_GRUND=github
  info=$(curl -fsSL "$RELEASES") || { echo "GitHub nicht erreichbar." >&2; exit 1; }
  AKT_ZIEL=$(jq -r '.tag_name // "" | ltrimstr("v")' <<<"$info" || true)
  url=$(jq -r '.assets[] | select(.name == "studium-server.tar.gz") | .browser_download_url' <<<"$info")
  if [ -z "$url" ]; then echo "Das neueste Release enthält noch kein Server-Paket; nichts zu tun."; exit 0; fi
  AKT_GRUND=pruefsumme-fehlt
  pruefsumme=$(jq -r '.assets[] | select(.name == "studium-server.tar.gz") | .digest // empty' <<<"$info")
  [ -n "$pruefsumme" ] || { echo "Keine Prüfsumme im Release; nichts installiert." >&2; exit 1; }
  AKT_GRUND=signatur-fehlt
  signatur=$(jq -r '.assets[] | select(.name == "studium-server.tar.gz.sig") | .browser_download_url' <<<"$info")
  [ -n "$signatur" ] || { echo "Keine Signatur im Release; nichts installiert." >&2; exit 1; }
  # Global statt local: Der trap läuft erst nach der Rückkehr aus dieser Funktion. Mit local war der Ordner dort schon unbekannt,
  # set -u brach ab, und jedes erfolgreiche Update endete mit Exit 1 und ließ den Download liegen.
  AKT_TMP=$(mktemp -d)
  AKT_GRUND=herunterladen
  curl -fsSL "$url" -o "$AKT_TMP/paket.tar.gz"
  curl -fsSL "$signatur" -o "$AKT_TMP/paket.tar.gz.sig"
  AKT_GRUND=pruefsumme
  echo "${pruefsumme#sha256:}  $AKT_TMP/paket.tar.gz" | sha256sum -c --quiet - || { echo "Prüfsumme stimmt nicht; nichts installiert." >&2; exit 1; }
  AKT_GRUND=signatur
  ssh-keygen -Y verify -f "$PAKET/allowed_signers" -I release@studium-autopilot -n studium-server -s "$AKT_TMP/paket.tar.gz.sig" \
    <"$AKT_TMP/paket.tar.gz" || { echo "Signatur ungültig oder kein Schlüssel im laufenden Paket; nichts installiert." >&2; exit 1; }
  AKT_GRUND=paket
  tar -xzf "$AKT_TMP/paket.tar.gz" -C "$AKT_TMP"
  neu=$(cat "$AKT_TMP/server/VERSION")
  AKT_ZIEL=$neu
  alt=$(cat "$PAKET/VERSION" 2>/dev/null || true)
  # Gleiche Version: aktuell nur, wenn ihre Installation bis zum Ende kam (installieren.sh legt .installiert zuletzt an). Sonst
  # stünde nach einem Abbruch einen Tag „installieren“ im Status, danach „Schon aktuell“, und der Server bliebe halb aktualisiert.
  if [ "$neu" = "$alt" ]; then
    if [ -f "$PAKET/.installiert" ]; then echo "Schon aktuell ($alt)."; exit 0; fi
    echo "$alt ist nicht fertig installiert (eine Installation brach ab): noch einmal."
  # Nur vorwärts: Ein Server mit neuerem Stand (z. B. aus einem Testpaket) geht nie auf ein älteres Release zurück.
  elif [ -n "$alt" ] && ! version_neuer "$neu" "$alt"; then
    echo "Installiert ist $alt, neuer als das Release ($neu); nichts zu tun."; exit 0
  fi
  AKT_GRUND=installieren
  # Noch ohne Adresse (vorbereitet, die Einrichtung in der Cloud Shell kam noch nicht): nur vorbereiten
  local ip
  ip=$(jq -r '.ip // empty' "$KONFIG")
  if [ -n "$ip" ]; then bash "$AKT_TMP/server/installieren.sh" --ip "$ip"; else bash "$AKT_TMP/server/installieren.sh" --vorbereiten; fi
}

case "${1:-hilfe}" in
  status)
    curl -fsS "http://127.0.0.1:$(port)/v1/status" | jq .
    for d in dienst speicher; do printf '%-9s %s\n' "$d" "$(systemctl is-active "studium-server-$d.service" || true)"; done
    takt=$(als_web cat "$DATEN/web/takt.json" 2>/dev/null || echo '{"uni_postfach":15,"gmail":3}')
    jq -r '"Takt aus Obsidian: Uni-Postfach alle \(.uni_postfach) Min., Gmail \(.gmail)-mal am Tag"' <<<"$takt"
    ;;
  verbinden)
    root_noetig verbinden
    [ -n "$(jq -r '.adresse // empty' "$KONFIG")" ] || { echo "Der Server hat noch keine Adresse. Erst die Einrichtung in der Cloud Shell abschließen: bash ~/studium-autopilot/start.sh" >&2; exit 1; }
    ausgabe=$(als_web node "$PAKET/verbinden.mjs")
    link=$(jq -r '.link' <<<"$ausgabe")
    echo "Code: $(jq -r '.code' <<<"$ausgabe") (gültig bis $(jq -r '.ablauf' <<<"$ausgabe"), einmal verwendbar)"
    echo "Link: $link"
    qrencode -t ANSIUTF8 "$link"
    ;;
  schluessel-erneuern) schluessel_erneuern ;;
  uni-zugang) shift; uni_zugang "$@" ;;
  zustand) als_studium node "$PAKET/zustand.mjs" ;;
  jetzt) als_studium node "$PAKET/lauf.mjs" --anstoss knopf; echo "Angestoßen; das Ergebnis zeigt: studium-server lauf" ;;
  modell)
    [[ "${2:-}" =~ ^(sonnet|opus)$ ]] || { echo "Erwartet: sonnet oder opus" >&2; exit 1; }
    als_studium bash -c "umask 077 && jq -n --arg m '$2' '{modell: \$m}' > '$DATEN/einstellungen.json'"
    echo "Modell für die Claude-Läufe: $2"
    ;;
  lauf)
    # als studium: Die Lauf-Ordner gehören ihm (0700)
    als_studium sh -c 'l=$(ls -1d "$1"/laeufe/*/ 2>/dev/null | tail -1); [ -n "$l" ] && jq . "$l/protokoll.json"' - "$DATEN" 2>/dev/null \
      || echo "Noch kein Claude-Lauf."
    ;;
  nutzung)
    # nutzung.json schreibt lauf.mjs je Tag (Berlin); Token rein = Eingabe samt Cache; gmail_begrenzt nur, wenn es vorkam
    als_studium cat "$DATEN/nutzung.json" 2>/dev/null | jq -r 'to_entries | sort_by(.key) | .[-7:][]
      | "\(.key)  \(.value.laeufe) Läufe (\(.value.opus) mit Opus, \(.value.limit) am Limit)  Token: \(.value.eingabe + .value.cache_lesen + .value.cache_schreiben) rein, \(.value.ausgabe) raus\(if (.value.gmail_begrenzt // 0) > 0 then "  Gmail-Überblick \(.value.gmail_begrenzt)× an der Grenze" else "" end)"' \
      || echo "Noch kein Claude-Lauf."
    ;;
  aktualisieren) aktualisieren ;;
  livesync) shift; root_noetig livesync; bash "$PAKET/livesync.sh" "$@" ;;
  hilfe|-h|--help) hilfe ;;
  *) hilfe; exit 1 ;;
esac
